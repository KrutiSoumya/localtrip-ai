<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Booking Confirmation</title>
</head>
<body style="font-family: Arial, sans-serif; margin: 40px; color: #222;">
  <h1 style="color: #2563eb;">{{agency_name}}</h1>
  <h2>Booking Confirmation Receipt</h2>

  <p><strong>Booking ID:</strong> {{booking_id}}</p>
  <p><strong>Customer:</strong> {{customer_name}}</p>
  <p><strong>Destination:</strong> {{destination}}</p>
  <p><strong>Itinerary:</strong> {{itinerary_title}}</p>
  <p><strong>Total Price:</strong> {{total_price}}</p>
  <p><strong>Booking Status:</strong> {{booking_status}}</p>
  <p><strong>Payment Status:</strong> {{payment_status}}</p>
  <p><strong>Booked At:</strong> {{booked_at}}</p>
  <p><strong>Travel Date:</strong> {{travel_date}}</p>

  <hr />

  <p style="font-size: 12px; color: #666;">
    Thank you for booking with {{agency_name}}. This receipt confirms your booking details.
  </p>
</body>
</html>