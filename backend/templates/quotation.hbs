<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Quotation</title>
</head>

<body style="font-family: Arial, sans-serif; margin: 40px; color: #222;">

  <!-- Header -->
  <div style="border-bottom: 3px solid #2563eb; padding-bottom: 15px; margin-bottom: 25px;">
    <h1 style="margin: 0; color: #2563eb;">{{agency_name}}</h1>
    <p style="margin: 4px 0;">{{agency_contact}} | {{agency_email}}</p>
    <p style="margin: 4px 0; color: #666;">Professional Travel Quotation</p>
  </div>

  <!-- Quote Info -->
  <div style="margin-bottom: 25px;">
    <p><strong>Quote Reference:</strong> {{quote_reference}}</p>
    <p><strong>Date Issued:</strong> {{date_issued}}</p>
    <p><strong>Valid Until:</strong> {{validity_date}}</p>
  </div>

  <!-- Customer -->
  <h2 style="color: #2563eb;">Customer Details</h2>
  <div style="background: #f3f4f6; padding: 15px; border-radius: 8px; margin-bottom: 25px;">
    <p><strong>Name:</strong> {{customer_name}}</p>
    <p><strong>Destination:</strong> {{destination}}</p>
    <p><strong>Group Size:</strong> {{group_size}}</p>
  </div>

  <!-- Cost Table -->
  <h2 style="color: #2563eb;">Itemised Cost Breakdown</h2>

  <table style="width: 100%; border-collapse: collapse; margin-bottom: 25px;">
    <thead>
      <tr style="background: #2563eb; color: white;">
        <th style="padding: 10px; border: 1px solid #ddd; text-align: left;">Item</th>
        <th style="padding: 10px; border: 1px solid #ddd; text-align: right;">Cost</th>
      </tr>
    </thead>

    <tbody>
      <tr>
        <td style="padding: 10px; border: 1px solid #ddd;">Accommodation</td>
        <td style="padding: 10px; border: 1px solid #ddd; text-align: right;">{{accommodation_cost}}</td>
      </tr>

      <tr>
        <td style="padding: 10px; border: 1px solid #ddd;">Transport</td>
        <td style="padding: 10px; border: 1px solid #ddd; text-align: right;">{{transport_cost}}</td>
      </tr>

      {{#each activities}}
      <tr>
        <td style="padding: 10px; border: 1px solid #ddd;">Activity: {{name}}</td>
        <td style="padding: 10px; border: 1px solid #ddd; text-align: right;">{{cost}}</td>
      </tr>
      {{/each}}

      <tr>
        <td style="padding: 10px; border: 1px solid #ddd;"><strong>Profit Margin</strong></td>
        <td style="padding: 10px; border: 1px solid #ddd; text-align: right;"><strong>{{profit_margin}}</strong></td>
      </tr>

      <tr style="background: #ecfdf5;">
        <td style="padding: 12px; border: 1px solid #ddd; font-size: 16px;"><strong>Grand Total</strong></td>
        <td style="padding: 12px; border: 1px solid #ddd; text-align: right; font-size: 16px;">
          <strong>{{grand_total}}</strong>
        </td>
      </tr>
    </tbody>
  </table>

  <!-- AI Summary -->
  <div style="background: #fff7ed; padding: 15px; border-radius: 8px; margin-bottom: 30px;">
    <h2 style="margin-top: 0; color: #c2410c;">AI Summary</h2>
    <p>{{ai_summary}}</p>
  </div>

  <!-- Signature -->
  <div style="margin-top: 50px;">
    <p><strong>Agent Signature:</strong></p>
    <div style="height: 60px; border-bottom: 1px solid #999; width: 300px;"></div>
    <p style="font-size: 13px; color: #666;">{{agent_name}}</p>
  </div>

  <!-- Footer -->
  <div style="border-top: 1px solid #ddd; margin-top: 40px; padding-top: 15px; font-size: 12px; color: #666; text-align: center;">
    <p>This quotation is valid for 7 days from the date issued.</p>
    <p>{{agency_name}} | Generated by LocalTrip AI</p>
  </div>

</body>
</html>