<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Itinerary</title>
</head>
<body style="font-family: Arial, sans-serif; color: #222; margin: 40px;">

  <div style="border-bottom: 3px solid #2563eb; padding-bottom: 15px; margin-bottom: 25px;">
    <div style="font-size: 28px; font-weight: bold;">{{agency_name}}</div>
    <div style="font-size: 14px; color: #555;">Logo Placeholder</div>
    <div style="margin-top: 8px; font-size: 14px;">
      Contact: {{agency_contact}} | Email: {{agency_email}}
    </div>
  </div>

  <h2 style="color: #2563eb;">Customer Details</h2>
  <div style="background: #f3f4f6; padding: 15px; border-radius: 8px; margin-bottom: 25px;">
    <p><strong>Name:</strong> {{customer_name}}</p>
    <p><strong>Email:</strong> {{customer_email}}</p>
    <p><strong>Phone:</strong> {{customer_phone}}</p>
    <p><strong>Destination:</strong> {{destination}}</p>
  </div>

  <h2 style="color: #2563eb;">Day-by-Day Itinerary</h2>
  <table style="width: 100%; border-collapse: collapse; margin-bottom: 25px;">
    <thead>
      <tr style="background: #2563eb; color: white;">
        <th style="padding: 10px; border: 1px solid #ddd;">Day</th>
        <th style="padding: 10px; border: 1px solid #ddd;">Activity</th>
        <th style="padding: 10px; border: 1px solid #ddd;">Location</th>
        <th style="padding: 10px; border: 1px solid #ddd;">Cost</th>
      </tr>
    </thead>
    <tbody>
      {{#each days}}
      <tr>
        <td style="padding: 10px; border: 1px solid #ddd;">{{day}}</td>
        <td style="padding: 10px; border: 1px solid #ddd;">{{activity}}</td>
        <td style="padding: 10px; border: 1px solid #ddd;">{{location}}</td>
        <td style="padding: 10px; border: 1px solid #ddd;">{{cost}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <div style="background: #ecfdf5; padding: 15px; border-radius: 8px; margin-bottom: 25px;">
    <h2 style="margin-top: 0; color: #047857;">Total Budget Summary</h2>
    <p><strong>Total Budget:</strong> {{total_budget}}</p>
    <p><strong>Currency:</strong> {{currency}}</p>
  </div>

  <div style="background: #fff7ed; padding: 15px; border-radius: 8px; margin-bottom: 30px;">
    <h2 style="margin-top: 0; color: #c2410c;">AI Confidence</h2>
    <p><strong>Confidence Label:</strong> {{ai_confidence_label}}</p>
  </div>

  <div style="border-top: 1px solid #ddd; padding-top: 15px; font-size: 12px; color: #666; text-align: center;">
    <p>{{agency_name}} | Generated by LocalTrip AI</p>
    <p>This itinerary is an estimate and may be adjusted based on availability and customer preferences.</p>
  </div>

</body>
</html>