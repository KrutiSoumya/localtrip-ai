generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  name        String
  agency_name String
  phone       String?
  createdAt   DateTime @default(now())
  leads       Lead[]
}

model Lead {
  id                Int         @id @default(autoincrement())
  customer_name     String
  phone             String
  email             String?
  inquiry_text      String
  destination       String?
  duration          Int?
  budget            Int?
  group_size        Int?
  preferences       String?
  source            String?
  status            String      @default("New")
  score             Int         @default(0)
  score_label       String      @default("Cold")
  last_contact      DateTime?
  interaction_count Int         @default(0)
  userId            Int
  createdAt         DateTime    @default(now())
  travel_date       DateTime?
  groupType         String?
  phoneHash         String?
  emailHash         String?
  bookings          Booking[]
  itineraries       Itinerary[]
  user              User        @relation(fields: [userId], references: [id])

  @@index([phoneHash])
  @@index([emailHash])
  @@index([source])
  @@index([userId, source])
}

model Itinerary {
  id         Int            @id @default(autoincrement())
  leadId     Int
  title      String
  summary    String?
  status     String         @default("approved")
  createdAt  DateTime       @default(now())
  bookings   Booking[]
  lead       Lead           @relation(fields: [leadId], references: [id])
  days       ItineraryDay[]
  quotations Quotation[]
}

model ItineraryDay {
  id                 Int       @id @default(autoincrement())
  itineraryId        Int
  day_number         Int
  title              String?
  activities         Json
  meals              String?
  hotel              String?
  transport          String?
  accommodation      String?
  accommodation_cost Int       @default(0)
  transport_cost     Int       @default(0)
  estimated_cost     Int       @default(0)
  itinerary          Itinerary @relation(fields: [itineraryId], references: [id])
}

model Quotation {
  id          Int       @id @default(autoincrement())
  itineraryId Int
  total_price Int
  currency    String    @default("GBP")
  notes       String?
  status      String    @default("Draft")
  sentAt      DateTime?
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  breakdown   Json?
  bookings    Booking[]
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id])
}

model Booking {
  id            Int        @id @default(autoincrement())
  leadId        Int
  itineraryId   Int
  quotationId   Int?
  status        String     @default("Pending")
  bookedAt      DateTime   @default(now())
  paymentStatus String     @default("Not Due")
  travelDate    DateTime?
  returnDate    DateTime?
  itinerary     Itinerary  @relation(fields: [itineraryId], references: [id])
  lead          Lead       @relation(fields: [leadId], references: [id])
  quotation     Quotation? @relation(fields: [quotationId], references: [id])
  invoice       Invoice?
}

model Invoice {
  id               Int       @id @default(autoincrement())
  invoice_number   String    @unique
  bookingId        Int       @unique
  quotation_amount Int
  line_items       Json
  adjustments      Json      @default("[]")
  final_amount     Int
  status           String    @default("Draft")
  public_token     String    @unique
  sent_at          DateTime?
  due_date         DateTime?
  paid_at          DateTime?
  payment_method   String?
  payment_ref      String?
  createdAt        DateTime  @default(now())
  booking          Booking   @relation(fields: [bookingId], references: [id])
}

model AILog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  leadId    Int?
  type      String   @default("itinerary_generation")
  input     Json
  output    Json
  action    String?
  reason    String?
  feedback  String?
  createdAt DateTime @default(now())
}

model AgentConfig {
  id                   Int      @id @default(autoincrement())
  name                 String
  preferences          String?
  destinations_dataset String?
  default_margin       Int      @default(15)
  createdAt            DateTime @default(now())
}
